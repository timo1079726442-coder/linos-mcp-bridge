{
  "name": "linos-mcp-bridge",
  "version": "0.1.5",
  "description": "Self-hosted MCP bridge: let AI clients safely use your local files, commands, Git and long-running jobs.",
  "license": "MIT",
  "author": "LinOS MCP Bridge contributors",
  "private": false,
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "chatgpt",
    "electron",
    "oauth",
    "local-first",
    "windows"
  ],
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:runtime": "npm --prefix runtime run build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "dev": "concurrently -k \"npm:dev:*\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev:renderer": "vite",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
    "build:portable": "npm run build:runtime && npm run build && electron-builder --win zip",
    "lint": "eslint src runtime/src"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "electron": "45.2.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "happy-dom": "^15.7.4",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  }
}
