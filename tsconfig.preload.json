{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.preload-tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/preload/**/*", "src/shared/**/*"]
}