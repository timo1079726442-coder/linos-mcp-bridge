# Dependencies
node_modules/
.pnpm-store/

# Build outputs (regenerated by the build scripts)
dist/
runtime/dist/

# Local installer outputs are reproducible and must not be committed.
release*/

# Acceptance evidence is regenerated by scripts/collect-evidence.mjs.
artifacts/acceptance/*.json
artifacts/acceptance/screenshots/
artifacts/acceptance/v21-screenshots/

# Electron
.electron/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs (kept locally only)
logs/
*.log

# Local state and runtime caches (kept locally only)
# Note: state/ in installed apps lives under %LOCALAPPDATA%\linos-c2c-control-center
.cache/
.tmp/

# Secrets (never commit)
*.pem
*.key
*.pfx
.env
.env.local
secrets.dpapi

__pycache__/
*.pyc

# 本地工具/实验/临时产物（不入库）
.claude/
.tooling/
experiments/
tmp/
artifacts/
tools/

# 一键脚本（需要入库）
!install.cmd
!start.cmd

# 本地 AI 交接数据（含需求原文、路径、决策），默认不进仓库
.c2c/
!src/**/logs/
!src/**/logs/**

# 构建产物与发行附件（走 Release，不入库）
release-portable/
*.zip
!extension/

